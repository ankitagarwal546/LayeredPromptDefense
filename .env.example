# Copy to .env and edit. .env is git-ignored; never commit real keys.
# Everything below is a placeholder. The app runs without any of it in mock mode.

# --- Main summarization model ------------------------------------------------
# mock               : deterministic development stub (NOT evidence about real LLM security)
# openai_compatible  : any server speaking the OpenAI chat-completions API
# anthropic          : Anthropic Messages API
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
# Used by openai_compatible only (e.g. a local server: http://localhost:11434/v1)
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
LLM_TIMEOUT_S=60

# --- Prompt-based injection classifier (Layer 2) ----------------------------------
# none disables it: the layer is then reported as "unavailable", never faked.
# Empty CLASSIFIER_MODEL / KEY / BASE_URL fall back to the LLM_* values above.
CLASSIFIER_PROVIDER=none
CLASSIFIER_MODEL=
CLASSIFIER_API_KEY=
CLASSIFIER_BASE_URL=

# --- API defaults ------------------------------------------------------------------
# Model used when a request does not say "mock" or "real". "real" needs LLM_PROVIDER != mock.
DEFAULT_MODEL_MODE=mock
# Defense preset applied when a request supplies none (see config.PRESETS).
DEFAULT_DEFENSE_PRESET=E4
LOG_LEVEL=INFO
